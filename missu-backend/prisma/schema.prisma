// 이 파일은 DB 설계도입니다. 변경 사항은 migration으로 순서대로 적용합니다.
// @map/@@map은 TypeScript 이름과 PostgreSQL 컬럼·테이블 이름을 연결합니다.
// onDelete: Restrict는 부모 데이터를 삭제할 때 관련 자료가 무심코 함께 지워지는 것을 막습니다.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  RETURNED
}

enum Category {
  OTHER
  ELECTRONICS
  WALLET_BAG
}

enum TimePrecision {
  EXACT
  APPROX
  DATE
}

enum ClaimStatus {
  PENDING
  REJECTED
  APPROVED
  HANDED_OVER
  RETURNED
  CLOSED
}

enum ChallengePurpose {
  SIGNUP
  RESET
  PHONE
}

// 계정 정보입니다. 비밀번호 원문을 저장하지 않고 해시만 보관합니다.
model User {
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(254)
  nickname           String              @db.VarChar(20)
  passwordHash       String              @map("password_hash")
  emailVerifiedAt    DateTime            @map("email_verified_at") @db.Timestamptz
  phoneCiphertext    String?             @map("phone_ciphertext")
  phoneVerifiedAt    DateTime?           @map("phone_verified_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  sessions           Session[]
  items              FoundItem[]
  photos             ItemPhoto[]
  lostReports        LostReport[]
  idempotencyRecords IdempotencyRecord[]
  auditEvents        AuditEvent[]
  challenges         AuthChallenge[]
  consents           Consent[]
  hansungDemoRequests HansungDemoRequest[]
  claims             Claim[]
  messages           Message[]
  abuseReports       AbuseReport[]
  routeRecordings    RouteRecording[]

  @@map("users")
}

// 로그인 상태를 DB에서 관리하여 로그아웃 시 서버에서도 즉시 만료시킵니다.
model Session {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String?         @map("user_id") @db.Uuid
  user        User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenDigest String          @unique @map("token_digest")
  csrfDigest  String          @map("csrf_digest")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt  DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz
  challenges  AuthChallenge[]

  @@index([expiresAt])
  @@map("sessions")
}

// 비회원에게 공개할 수 있는 습득물 정보입니다. 비공개 특징은 아래 별도 테이블을 사용합니다.
model FoundItem {
  appCategory String? @map("app_category") @db.VarChar(16)
  archived Boolean @default(false)
  id             String           @id @default(uuid()) @db.Uuid
  keeperId       String           @map("keeper_id") @db.Uuid
  keeper         User             @relation(fields: [keeperId], references: [id], onDelete: Restrict)
  name           String           @db.VarChar(20)
  category       Category         @default(OTHER)
  publicFeatures String?          @map("public_features") @db.VarChar(100)
  foundAt        DateTime         @map("found_at") @db.Timestamptz
  foundLabel     String           @map("found_label") @db.VarChar(200)
  lat            Decimal          @db.Decimal(9, 6)
  lng            Decimal          @db.Decimal(9, 6)
  storagePlace   String           @map("storage_place") @db.VarChar(200)
  pickupGuide    String?          @map("pickup_guide") @db.VarChar(100)
  status         ItemStatus       @default(AVAILABLE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  secret         FoundItemSecret?
  photos         ItemPhoto[]
  claims         Claim[]

  @@index([status, createdAt, id])
  @@index([keeperId, createdAt, id])
  @@index([lat, lng])
  @@map("found_items")
}

// 소유 확인 단서입니다. 암호화된 값만 저장하고 등록자만 복원해 조회합니다.
model FoundItemSecret {
  itemId             String    @id @map("item_id") @db.Uuid
  item               FoundItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  featuresCiphertext String    @map("features_ciphertext")

  @@map("found_item_secrets")
}

// 처음 올린 사진은 READY, 물품에 연결된 사진은 ATTACHED입니다.
model ItemPhoto {
  reportId String? @map("report_id") @db.Uuid
  report AbuseReport? @relation(fields: [reportId], references: [id], onDelete: Restrict)
  id         String     @id @default(uuid()) @db.Uuid
  uploaderId String     @map("uploader_id") @db.Uuid
  uploader   User       @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  itemId     String?    @map("item_id") @db.Uuid
  item       FoundItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  objectKey  String     @unique @map("object_key")
  mime       String
  byteSize   Int        @map("byte_size")
  width      Int
  height     Int
  state      String     @default("READY")
  sortOrder  Int?       @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([reportId], map: "item_photos_report_idx")
  @@unique([itemId, sortOrder])
  @@index([uploaderId, state, createdAt])
  @@map("item_photos")
}

// 분실 신고는 공개 목록과 분리하며, 대략적인 시간 범위를 그대로 보존합니다.
model LostReport {
  category      String        @default("OTHER") @db.VarChar(16)
  placeName     String?       @map("place_name") @db.VarChar(200)
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  name          String        @db.VarChar(20)
  features      String?       @db.VarChar(100)
  lostStart     DateTime      @map("lost_start") @db.Timestamptz
  lostEnd       DateTime      @map("lost_end") @db.Timestamptz
  timePrecision TimePrecision @map("time_precision")
  lostLabel     String        @map("lost_label") @db.VarChar(200)
  lat           Decimal       @db.Decimal(9, 6)
  lng           Decimal       @db.Decimal(9, 6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, createdAt, id])
  @@map("lost_reports")
}

// 같은 등록을 다시 보내는 경우 새 물품을 만들지 않고 저장된 성공 결과를 돌려줍니다.
model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  route        String
  key          String   @db.Uuid
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt    DateTime @map("expires_at") @db.Timestamptz

  @@unique([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// 누가 언제 무엇을 등록했는지 남깁니다. 특징·전화번호 등 민감한 본문은 기록하지 않습니다.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  requestId  String   @map("request_id")
  fromState  String?  @map("from_state")
  toState    String?  @map("to_state")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_events")
}

// 인증번호는 서버 키로 HMAC 처리하고, 이메일·전화번호 원문은 암호화합니다.
model AuthChallenge {
  id               String           @id @default(uuid()) @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  session          Session          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  userId           String?          @map("user_id") @db.Uuid
  user             User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose          ChallengePurpose
  targetCiphertext String           @map("target_ciphertext")
  targetDigest     String           @map("target_digest")
  codeDigest       String           @map("code_digest")
  proofDigest      String?          @map("proof_digest")
  deliveryStatus   String           @default("PENDING") @map("delivery_status")
  attempts         Int              @default(0)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz
  verifiedAt       DateTime?        @map("verified_at") @db.Timestamptz
  consumedAt       DateTime?        @map("consumed_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([sessionId, purpose, createdAt])
  @@index([targetDigest, createdAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}

// 약관 문구를 대신하지 않는 동의 이력입니다. 운영 정책 버전은 배포 전에 확정합니다.
model Consent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind          String
  policyVersion String   @map("policy_version") @db.VarChar(80)
  agreedAt      DateTime @default(now()) @map("agreed_at") @db.Timestamptz

  @@unique([userId, kind, policyVersion])
  @@map("consents")
}

// 보관자 전달과 요청자 수령을 별도 상태로 저장합니다. DB의 부분 유일 인덱스로 단일 승인을 보장합니다.
model Claim {
  id             String        @id @default(uuid()) @db.Uuid
  itemId         String        @map("item_id") @db.Uuid
  item           FoundItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  requesterId    String        @map("requester_id") @db.Uuid
  requester      User          @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  features       String        @db.VarChar(300)
  lostStart      DateTime?      @map("lost_start") @db.Timestamptz
  lostEnd        DateTime?      @map("lost_end") @db.Timestamptz
  timePrecision  TimePrecision? @map("time_precision")
  lostLabel      String?        @map("lost_label") @db.VarChar(200)
  lat            Decimal?       @db.Decimal(9, 6)
  lng            Decimal?       @db.Decimal(9, 6)
  lostInfo       String?       @map("lost_info") @db.VarChar(500)
  appointment    Json?
  status         ClaimStatus   @default(PENDING)
  decisionReason String?       @map("decision_reason") @db.VarChar(300)
  approvedAt     DateTime?     @map("approved_at") @db.Timestamptz
  handedOverAt   DateTime?     @map("handed_over_at") @db.Timestamptz
  receivedAt     DateTime?     @map("received_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  messages       Message[]
  reports        AbuseReport[]

  @@index([requesterId, createdAt, id])
  @@index([itemId, status])
  @@map("claims")
}

model Message {
  id              String   @id @default(uuid()) @db.Uuid
  claimId         String   @map("claim_id") @db.Uuid
  claim           Claim    @relation(fields: [claimId], references: [id], onDelete: Restrict)
  senderId        String   @map("sender_id") @db.Uuid
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body            String   @db.VarChar(200)
  clientMessageId String   @map("client_message_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([senderId, clientMessageId])
  @@index([claimId, createdAt, id])
  @@map("messages")
}

// 신고는 접수만 기록합니다. 자동 거절이나 계정 차단은 하지 않습니다.
model AbuseReport {
  photos ItemPhoto[]
  description String? @db.VarChar(1000)
  id         String   @id @default(uuid()) @db.Uuid
  claimId    String   @map("claim_id") @db.Uuid
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Restrict)
  reporterId String   @map("reporter_id") @db.Uuid
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  reason     String   @db.VarChar(200)
  status     String   @default("RECEIVED")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([claimId, reporterId])
  @@map("abuse_reports")
}

// 13개 업무 테이블 외의 공통 제한 저장소입니다. 서버를 재시작해도 인증 시도 제한이 유지됩니다.
model RateLimitBucket {
  id        String   @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// 전국 검색은 완료된 집계를 유지하면서 다음 집계를 별도로 작성합니다.
model AgencyCountSnapshot {
  query       String    @id
  generation  Int       @default(1)
  page        Int       @default(1)
  listTotal   Int?      @map("list_total")
  listed      Boolean   @default(false)
  total       Int?
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  retryAt     DateTime  @default(now()) @map("retry_at") @db.Timestamptz
  candidates  AgencyCountCandidate[]

  @@map("agency_count_snapshots")
}

model AgencyCountCandidate {
  query      String
  generation Int
  atcId      String   @map("atc_id")
  fdSn       String   @map("fd_sn")
  stored     Boolean?
  retryAfter DateTime? @map("retry_after") @db.Timestamptz
  snapshot   AgencyCountSnapshot @relation(fields: [query], references: [query], onDelete: Cascade)

  @@id([query, generation, atcId, fdSn])
  @@index([query, generation, stored])
  @@map("agency_count_candidates")
}

// 포털이 실제로 응답한 공개 필드와 확인 시각만 저장합니다.
model VerifiedPortalItem {
  searchFragments String[] @default(dbgenerated()) @map("search_fragments")
  kindName String? @map("kind_name")
  foundPlace String? @map("found_place")
  phone String?
  id String @id
  name String
  source String
  storage String
  placeKey String @map("place_key")
  day String
  category String
  stored Boolean
  checkedAt DateTime @map("checked_at") @db.Timestamptz
  @@index([stored, day, id])
  @@index([searchFragments], type: Gin, map: "verified_items_fragments_gin")
  @@map("verified_portal_items")
}

// 검색어와 장소 원문을 남기지 않고, 마지막으로 완전히 확인한 합계만 보존합니다.
model LastSearchCount {
  queryKey String @id @map("query_key")
  total Int
  policeIncluded Boolean @map("police_included")
  checkedAt DateTime @map("checked_at") @db.Timestamptz
  @@map("last_search_counts")
}

model AgencyCountBudget {
  day   String @id
  calls Int

  @@map("agency_count_budgets")
}

// 동의하고 시작한 위치 기록 단위입니다. 한 사용자는 한 번에 한 기록만 진행합니다.
model RouteRecording {
  id            String       @id @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source        String       @db.VarChar(10)
  policyVersion String       @map("policy_version") @db.VarChar(80)
  startedAt     DateTime     @map("started_at") @db.Timestamptz
  autoStopsAt   DateTime     @map("auto_stops_at") @db.Timestamptz
  stoppedAt     DateTime?    @map("stopped_at") @db.Timestamptz
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz
  points        RoutePoint[]

  @@index([userId, startedAt])
  @@index([expiresAt])
  @@map("route_recordings")
}

// 좌표와 정확도는 암호문으로만 저장합니다. 만료 시간은 수신 시각이 아닌 관측 시각 + 48시간입니다.
model RoutePoint {
  id                 String         @id @default(uuid()) @db.Uuid
  recordingId        String         @map("recording_id") @db.Uuid
  recording          RouteRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  clientPointId      String         @map("client_point_id") @db.Uuid
  recordedAt         DateTime       @map("recorded_at") @db.Timestamptz
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz
  positionCiphertext String         @map("position_ciphertext")
  payloadHash        String         @map("payload_hash")

  @@unique([recordingId, clientPointId])
  @@index([recordingId, recordedAt, id])
  @@index([expiresAt])
  @@map("route_points")
}

model HansungDemoRequest {
  id String @id @db.Uuid
  requesterId String @map("requester_id") @db.Uuid
  requester User @relation(fields:[requesterId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  status String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@index([updatedAt(sort: Desc),id],map:"hansung_demo_inbox")
  @@map("hansung_demo_requests")
}
