# npm run local:setup creates a private .env with random passwords and keys.
DATABASE_URL=postgresql://missu_app:YOUR_PASSWORD@127.0.0.1:54329/missu_dev
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
STORAGE_PATH=.local/photos
PII_KEY=YOUR_64_HEX_CHARACTERS
SIGNING_KEY=YOUR_OTHER_64_HEX_CHARACTERS

# 개발 대역은 실제 이메일/SMS를 발송하지 않고 .local/outbox에 코드를 저장합니다.
EMAIL_PROVIDER=local
SMS_PROVIDER=local
OUTBOX_PATH=.local/outbox
POLICY_VERSION=dev-v1
PLACE_PROVIDER=disabled
STORAGE_PROVIDER=local
TRUST_PROXY_HOPS=0

# 외부 연동을 사용할 때 provider를 resend / solapi / kakao / supabase로 변경합니다.
RESEND_API_KEY=
EMAIL_FROM=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_FROM=
KAKAO_REST_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
